# Clé API Claude
ANTHROPIC_API_KEY=

# Optionnel — Postgres pour que les pauses survivent à un redémarrage.
# Utiliser un projet Neon dédié, jamais la base de prod.
# Terminer l'URL par ?sslmode=verify-full : le certificat du serveur est alors vérifié,
# et le comportement ne changera pas avec la prochaine version majeure de pg.
# Sans cette variable, l'état reste en mémoire.
DATABASE_URL=

# Simule l'utilisateur authentifié (en production : la session JWT)
SESSION_USER_EMAIL=evan@example.com

# Agent SEO — app créée dans le Dev Dashboard Shopify (droits read_products, write_products)
# SHOPIFY_SHOP = ce qui précède .myshopify.com dans l'adresse de la boutique
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Administrateur qui valide les actions critiques (en production : sa session, jamais une saisie libre).
# Son identité est inscrite dans le journal d'audit du thread.
ADMIN_EMAIL=admin@example.com
